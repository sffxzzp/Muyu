# 幕语 Docker Compose 配置。需要自定义时复制为 .env。
# 宿主机的监听地址和端口；容器内始终监听 0.0.0.0:7777。
MUYU_BIND_IP=127.0.0.1
MUYU_PORT=7777

# 首次访问的界面语言：en / zh-CN。用户在浏览器中保存的语言选择优先。
UI_LANG=en

# 仅限制服务器转发的模型域名；浏览器直连不受此名单限制。
# 逗号分隔；替换整个列表。不要填写协议或路径。
# 默认允许 NVIDIA、DeepSeek、OpenAI、OpenRouter。
# 精确匹配，未写端口时仅允许 443；自定义端口示例：api.example.com:8443。
# 仅在明确需要开放任意公网 HTTPS 接口时设为 *，现有内网访问限制仍生效。
API_HOSTS=integrate.api.nvidia.com,api.deepseek.com,api.openai.com,openrouter.ai

# 服务端每分钟持续请求速率，启动时最多允许 10 次突发（不超过 RPM）。
# IP 和全站限制覆盖本站 POST API；HOST 仅限制服务器向模型转发的请求。
# 浏览器直连不计入这些额度，但仍遵守任务 RPM 和服务商限额。
IP_RPM=60
HOST_RPM=300
GLOBAL_RPM=600

# 同一来源 IP、同一模型域名、整个实例的同时处理请求数。
# 达到上限立即返回 429，翻译任务在浏览器等待；服务端不积压排队请求。
IP_CONCURRENCY=2
HOST_CONCURRENCY=8
MAX_CONCURRENT_REQUESTS=32

# 默认不信任代理头。仅填写 Go 服务前方受控反向代理的 IP / CIDR。
# 例如同机 Caddy：127.0.0.1/32,::1/128。Docker 中填写实际代理地址。
TRUSTED_PROXIES=

# 仅在私有部署需要服务器转发到 HTTP / 内网模型时改为 true；不限制浏览器直连。
ALLOW_PRIVATE_UPSTREAMS=false
